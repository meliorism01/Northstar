# ============================================================================
# NORTHSTAR — Environment Configuration Template
# Copy this file to `.env` for local development. Never commit `.env` to Git.
# ============================================================================

# --- Frontend Vite Configuration ---
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# --- Spring Boot Application ---
# Active profile options:
#   local    -> Local PostgreSQL (default: 127.0.0.1:5433/ordexa_db)
#   supabase -> Supabase Cloud PostgreSQL (Shared Pooler Session Mode, SSL required)
#   docker   -> Docker Compose PostgreSQL service (postgres:5432/ordexa_db)
#   prod     -> Production environment (strict secrets, TLS cookies)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# --- Option A: Local PostgreSQL (used when SPRING_PROFILES_ACTIVE=local or docker) ---
POSTGRES_DB=ordexa_db
POSTGRES_USER=ordexa_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ordexa_db
DB_USERNAME=ordexa_app
DB_PASSWORD=
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# --- Option B: Supabase Cloud PostgreSQL (used when SPRING_PROFILES_ACTIVE=supabase) ---
# Shared Pooler (Session Mode) connection details. Leave password empty here;
# set SUPABASE_DB_PASSWORD in your local `.env` or shell environment.
SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.cumzjxsxjxvhhldsjluj
SUPABASE_DB_PASSWORD=

# --- Optional Standard Spring DataSource Overrides (takes precedence if set) ---
# Example for Supabase: jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Option B: Supabase Cloud PostgreSQL (used when SPRING_PROFILES_ACTIVE=supabase) ---
# Shared Pooler (Session Mode) connection details. Leave password empty here;
# set SUPABASE_DB_PASSWORD in your local `.env` or shell environment.
SUPABASE_DB_HOST=aws-1-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.cumzjxsxjxvhhldsjluj
SUPABASE_DB_PASSWORD=

# --- Optional Standard Spring DataSource Overrides (takes precedence if set) ---
# Example for Supabase: jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- JWT & Refresh Token Security ---
# Must be at least 32 characters (256-bit) for HMAC-SHA256 signing
JWT_SECRET=
JWT_ISSUER=https://auth.ordexa.internal
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# --- Refresh Cookie Settings ---
AUTH_COOKIE_NAME=ordexa_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# --- Security & CORS ---
# Comma-separated list of allowed frontend origins (no wildcards with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenAPI / Swagger UI ---
SWAGGER_ENABLED=true
