# ============================================================================
# ORDEXA — Environment Configuration Template (Milestone 2)
# Copy this file to `.env` for local development. Never commit `.env` to Git.
# ============================================================================

# --- Frontend Vite Configuration ---
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# --- Spring Boot Application ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# --- PostgreSQL Container (used by docker-compose.yml) ---
POSTGRES_DB=ordexa_db
POSTGRES_USER=ordexa_app
POSTGRES_PASSWORD=change_me_local_dev_password_only
POSTGRES_PORT=5432

# --- Backend JDBC Connection ---
# Use 127.0.0.1 (port 5433 for local pg_ctl cluster or 5432 for Docker)
# Use `postgres` (the Docker Compose service name) when running inside Docker.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ordexa_db
DB_USERNAME=ordexa_app
DB_PASSWORD=change_me_local_dev_password_only
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# --- JWT & Refresh Token Security ---
# Must be at least 32 characters (256-bit) for HMAC-SHA256 signing
JWT_SECRET=replace_with_at_least_32_byte_cryptographic_secret_key_for_ordexa
JWT_ISSUER=https://auth.ordexa.internal
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# --- Refresh Cookie Settings ---
AUTH_COOKIE_NAME=ordexa_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# --- Security & CORS ---
# Comma-separated list of allowed frontend origins (no wildcards with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenAPI / Swagger UI ---
SWAGGER_ENABLED=true
